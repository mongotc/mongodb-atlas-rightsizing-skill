# MongoDB Atlas rightsizing — environment variables
#
# Copy this file to `.env` (git-ignored) and fill in real values, then source it:
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Never paste secrets into chat or pass them as CLI flags — the scripts read
# credentials from the environment so they don't land in shell history or `ps`.

# --------------------------------------------------------------------------
# Atlas Admin API credentials — used by scripts/rightsizing.py
# --------------------------------------------------------------------------
# Provide EITHER a Service Account (preferred, OAuth2) OR a legacy API key.
# Needs at least Project Read Only on every project you want to audit.

# Service Account (preferred)
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# Legacy API key (HTTP Digest) — only if you can't use a Service Account
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=


# --------------------------------------------------------------------------
# Shared monitoring user — used by scripts/atlas_db_diagnostics.py
# --------------------------------------------------------------------------
# The multi-cluster wrapper pulls each cluster's SRV host from the Atlas API
# and combines it with these credentials. Provision the same DB user in every
# audited cluster with:
#   - clusterMonitor (built-in, on `admin`)
#   - a custom role granting dbStats + collStats + listCollections
# Verify with:  mongosh "<uri>" --file scripts/permissions_check.js
RIGHT_SIZING_USER=
RIGHT_SIZING_PASSWORD=

# --------------------------------------------------------------------------
# Output folder — used by src/extraction/extract.py (CLI)
# --------------------------------------------------------------------------
# Path RELATIVE TO THE PROJECT ROOT where extraction files land.
# The full default path is: <project root>/<OUTPUT_DIR>/<cluster>/extraction.json
# Leave as `output` to keep files under the project root's output/ folder.
# An absolute path here is respected as-is.
OUTPUT_DIR=output